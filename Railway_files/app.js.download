/**
 * Main Web Application Controller for the Railway Reservation System.
 */

// Application State
const AppState = {
    selectedTrain: null,
    selectedClass: "3A",
    selectedQuota: "GENERAL",
    fromStation: "NDLS",
    toStation: "HWH",
    currentSearchResults: [],
    passengers: [
        { name: "Harish Verma (Senior)", age: 68, gender: "M", prefBerth: "LOWER", isSenior: true },
        { name: "Meenakshi Verma (Mother)", age: 40, gender: "F", prefBerth: "LOWER", isSenior: false },
        { name: "Rohan Verma (Son)", age: 14, gender: "M", prefBerth: "UPPER", isSenior: false }
    ],
    bookedTickets: new Map()
};

// DOM Initialization
document.addEventListener("DOMContentLoaded", () => {
    populateSelectOptions();
    setupTabNavigation();
    setupEventListeners();
    
    // Seed initial booking for PNR lookup demo
    seedInitialDemoBooking();
    
    // Trigger initial search
    executeSearch();
});

function populateSelectOptions() {
    const srcSelect = document.getElementById("srcStation");
    const destSelect = document.getElementById("destStation");
    const splitSrcSelect = document.getElementById("splitSrcStation");
    const splitDestSelect = document.getElementById("splitDestStation");
    
    const classSelect = document.getElementById("coachClass");
    const quotaSelect = document.getElementById("quotaType");

    // Populate Stations
    RAILWAY_DATA.stations.forEach(s => {
        const opt1 = new Option(`${s.name} (${s.code})`, s.code);
        const opt2 = new Option(`${s.name} (${s.code})`, s.code);
        const opt3 = new Option(`${s.name} (${s.code})`, s.code);
        const opt4 = new Option(`${s.name} (${s.code})`, s.code);
        
        srcSelect.add(opt1);
        destSelect.add(opt2);
        splitSrcSelect.add(opt3);
        splitDestSelect.add(opt4);
    });

    srcSelect.value = "NDLS";
    destSelect.value = "HWH";
    splitSrcSelect.value = "NDLS";
    splitDestSelect.value = "HWH";

    // Populate Classes
    RAILWAY_DATA.classes.forEach(c => {
        classSelect.add(new Option(`${c.icon} ${c.name}`, c.code));
    });
    classSelect.value = "3A";

    // Populate Quotas
    RAILWAY_DATA.quotas.forEach(q => {
        quotaSelect.add(new Option(q.name, q.code));
    });
    quotaSelect.value = "GENERAL";

    renderPassengerList();
}

function setupTabNavigation() {
    const tabs = document.querySelectorAll(".tab-btn");
    tabs.forEach(tab => {
        tab.addEventListener("click", () => {
            tabs.forEach(t => t.classList.remove("active"));
            document.querySelectorAll(".tab-panel").forEach(p => p.classList.remove("active"));
            
            tab.classList.add("active");
            const target = tab.getAttribute("data-tab");
            const panel = document.getElementById(target);
            if (panel) panel.classList.add("active");
        });
    });
}

function setupEventListeners() {
    document.getElementById("searchBtn").addEventListener("click", executeSearch);
    document.getElementById("swapStationsBtn").addEventListener("click", () => {
        const src = document.getElementById("srcStation");
        const dest = document.getElementById("destStation");
        const tmp = src.value;
        src.value = dest.value;
        dest.value = tmp;
        executeSearch();
    });

    document.getElementById("findSplitBtn").addEventListener("click", executeSplitSearch);
    document.getElementById("addPassengerBtn").addEventListener("click", addPassenger);
    document.getElementById("sampleFamilyBtn").addEventListener("click", loadSampleFamily);
    document.getElementById("confirmBookingBtn").addEventListener("click", processReservation);
    document.getElementById("queryPnrBtn").addEventListener("click", queryPnrStatus);
    document.getElementById("cancelPnrBtn").addEventListener("click", cancelPnrBooking);
}

// ----------------- SEARCH & SORTING -----------------
function executeSearch() {
    const from = document.getElementById("srcStation").value;
    const to = document.getElementById("destStation").value;
    const coachClass = document.getElementById("coachClass").value;
    const quota = document.getElementById("quotaType").value;
    const criteria = document.getElementById("sortCriteria").value;
    const algorithm = document.getElementById("sortAlgorithm").value;

    AppState.fromStation = from;
    AppState.toStation = to;
    AppState.selectedClass = coachClass;
    AppState.selectedQuota = quota;

    // Filter trains serving this route
    const matchingTrains = RAILWAY_DATA.trains.filter(t => {
        const r1 = t.routes.find(r => r.station === from);
        const r2 = t.routes.find(r => r.station === to);
        return r1 && r2 && r1.seq < r2.seq;
    });

    const comparator = SortingEngine.getComparator(criteria, from, to, coachClass, quota);
    let result;

    if (algorithm === "MERGE_SORT") {
        result = SortingEngine.runMergeSort(matchingTrains, comparator);
    } else {
        result = SortingEngine.runQuickSort(matchingTrains, comparator);
    }

    AppState.currentSearchResults = result.sortedList;
    renderTelemetry(algorithm, criteria, result);
    renderTrainCards(result.sortedList, from, to, coachClass, quota);
}

function renderTelemetry(algorithm, criteria, result) {
    const strip = document.getElementById("telemetryStrip");
    const algoTitle = algorithm === "MERGE_SORT" ? "MergeSort [Stable O(N log N)]" : "QuickSort [Median-of-3 O(N log N)]";
    strip.innerHTML = `
        <div class="telemetry-metrics">
            <span>⚡ Algorithm:</span> ${algoTitle} &nbsp;|&nbsp;
            <span>Criteria:</span> ${criteria.replace(/_/g, " ")} &nbsp;|&nbsp;
            <span>Comparisons:</span> ${result.comparisons} &nbsp;|&nbsp;
            <span>Swaps:</span> ${result.swaps} &nbsp;|&nbsp;
            <span>Time:</span> ${result.durationMs.toFixed(3)} ms
        </div>
        <div class="telemetry-badge">JVM Algorithm Simulator Ready</div>
    `;
}

function renderTrainCards(trains, from, to, coachClass, quota) {
    const container = document.getElementById("trainListContainer");
    container.innerHTML = "";

    if (trains.length === 0) {
        container.innerHTML = `
            <div style="text-align: center; padding: 3rem; background: #fff; border-radius: 12px; border: 1px dashed var(--border-color);">
                <h3>No direct trains found for ${from} ➔ ${to}</h3>
                <p style="color: var(--text-muted); margin-top: 0.5rem;">Try checking the <b>Smart Split-Ticket Recommender</b> tab for connecting routes via junction stations!</p>
            </div>
        `;
        return;
    }

    trains.forEach(t => {
        const fare = SortingEngine.calculateFare(t, from, to, coachClass, quota);
        const smartScore = SortingEngine.calculateCompositeScore(t, fare);
        const availSeats = t.seats[coachClass] || 0;

        const card = document.createElement("div");
        card.className = "train-card";
        card.innerHTML = `
            <div class="train-info-left">
                <h3>[${t.number}] ${t.name}</h3>
                <span class="train-type-badge">${t.type}</span>
            </div>

            <div class="train-timing">
                <div class="time-box">
                    <div class="time">${t.depTime}</div>
                    <div class="stn">${from}</div>
                </div>
                <div class="duration-line">
                    <span>${Math.floor(t.durationMins / 60)}h ${t.durationMins % 60}m</span>
                    <div class="duration-bar"></div>
                </div>
                <div class="time-box">
                    <div class="time">${t.arrTime}</div>
                    <div class="stn">${to}</div>
                </div>
            </div>

            <div class="metric-pill-group">
                <div class="metric-pill stars">★ ${t.punctuality} Punctuality</div>
                <div class="metric-pill eco">🌱 ${t.ecoScore}/100 Eco-Score</div>
                <div class="metric-pill smart">AI Score: ${smartScore.toFixed(1)}</div>
            </div>

            <div class="price-action-box">
                <div class="fare-amount">₹${fare}</div>
                <div class="seats-avail ${availSeats > 0 ? '' : 'seats-wl'}">
                    ${availSeats > 0 ? `✓ Available (${availSeats} seats)` : `⚠️ WL (Waitlist)`}
                </div>
                <div style="display: flex; gap: 0.5rem; margin-top: 0.35rem;">
                    <button class="btn-outline" onclick="openCoachLayoutModal('${t.number}', '${coachClass}')">Layout</button>
                    <button class="btn-primary" onclick="selectTrainForBooking('${t.number}')">Book</button>
                </div>
            </div>
        `;
        container.appendChild(card);
    });
}

// ----------------- 2D COACH LAYOUT -----------------
function openCoachLayoutModal(trainNum, coachClass) {
    const train = RAILWAY_DATA.trains.find(t => t.number === trainNum);
    if (!train) return;

    const modal = document.getElementById("coachLayoutModal");
    const title = document.getElementById("modalTrainTitle");
    const grid = document.getElementById("coachGridContainer");

    title.innerText = `[${train.number}] ${train.name} - Class ${coachClass} Berth Map`;
    grid.innerHTML = "";

    // Generate 64-seat layout
    for (let i = 1; i <= 64; i++) {
        const mod = i % 8;
        let berthCode = "LB";
        let isSeniorPref = false;

        switch (mod) {
            case 1: case 4: berthCode = "LB"; isSeniorPref = true; break;
            case 2: case 5: berthCode = "MB"; break;
            case 3: case 6: berthCode = "UB"; break;
            case 7: berthCode = "SL"; isSeniorPref = true; break;
            case 0: berthCode = "SU"; break;
        }

        const isBooked = (i % 5 === 0); // Mock occupied seats

        const box = document.createElement("div");
        box.className = `berth-box ${isSeniorPref ? 'senior-pref' : ''} ${isBooked ? 'booked' : ''}`;
        box.innerHTML = `
            <div class="berth-num">#${i}</div>
            <div class="berth-code">${berthCode}</div>
        `;
        if (!isBooked) {
            box.addEventListener("click", () => {
                document.querySelectorAll(".berth-box").forEach(b => b.classList.remove("selected"));
                box.classList.add("selected");
            });
        }
        grid.appendChild(box);
    }

    modal.classList.add("active");
}

function closeCoachModal() {
    document.getElementById("coachLayoutModal").classList.remove("active");
}

// ----------------- SPLIT TICKET RECOMMENDER -----------------
function executeSplitSearch() {
    const from = document.getElementById("splitSrcStation").value;
    const to = document.getElementById("splitDestStation").value;
    const coachClass = document.getElementById("coachClass").value;
    const quota = document.getElementById("quotaType").value;
    const container = document.getElementById("splitRoutesContainer");
    container.innerHTML = "";

    // Junction list
    const junctions = RAILWAY_DATA.stations.filter(s => s.isJunction && s.code !== from && s.code !== to);
    const splitOptions = [];

    junctions.forEach(j => {
        const leg1Trains = RAILWAY_DATA.trains.filter(t => {
            const r1 = t.routes.find(r => r.station === from);
            const r2 = t.routes.find(r => r.station === j.code);
            return r1 && r2 && r1.seq < r2.seq;
        });

        const leg2Trains = RAILWAY_DATA.trains.filter(t => {
            const r1 = t.routes.find(r => r.station === j.code);
            const r2 = t.routes.find(r => r.station === to);
            return r1 && r2 && r1.seq < r2.seq;
        });

        leg1Trains.forEach(t1 => {
            leg2Trains.forEach(t2 => {
                if (t1.number !== t2.number) {
                    const fare1 = SortingEngine.calculateFare(t1, from, j.code, coachClass, quota);
                    const fare2 = SortingEngine.calculateFare(t2, j.code, to, coachClass, quota);
                    splitOptions.push({
                        leg1: t1,
                        junction: j,
                        leg2: t2,
                        fare: fare1 + fare2,
                        totalDuration: t1.durationMins + t2.durationMins + 75
                    });
                }
            });
        });
    });

    if (splitOptions.length === 0) {
        container.innerHTML = `<p style="padding: 2rem; text-align: center;">No valid split-ticket junction connections found.</p>`;
        return;
    }

    splitOptions.sort((a, b) => a.totalDuration - b.totalDuration);

    splitOptions.slice(0, 4).forEach(opt => {
        const card = document.createElement("div");
        card.className = "split-timeline-card";
        card.innerHTML = `
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <h4 style="color: var(--midnight-blue); font-size: 1.1rem;">🔀 Confirmed Split-Ticket Connection</h4>
                <div style="font-weight: 800; font-size: 1.3rem; color: var(--vintage-brown);">Total: ₹${opt.fare}</div>
            </div>
            <div class="split-legs-wrapper">
                <div class="leg-card">
                    <b>Leg 1: [${opt.leg1.number}] ${opt.leg1.name}</b>
                    <div>Dep: ${opt.leg1.depTime} (${from}) ➔ Arr: ${opt.leg1.arrTime} (${opt.junction.code})</div>
                    <div style="color: var(--success-green); font-size: 0.8rem; font-weight: 700;">✓ Confirmed Berth Available</div>
                </div>
                <div class="transfer-hub-pill">
                    ⚡ Transfer @ ${opt.junction.name} (${opt.junction.code})<br>
                    <small>Layover: ~75 mins</small>
                </div>
                <div class="leg-card">
                    <b>Leg 2: [${opt.leg2.number}] ${opt.leg2.name}</b>
                    <div>Dep: ${opt.leg2.depTime} (${opt.junction.code}) ➔ Arr: ${opt.leg2.arrTime} (${to})</div>
                    <div style="color: var(--success-green); font-size: 0.8rem; font-weight: 700;">✓ Confirmed Berth Available</div>
                </div>
            </div>
            <button class="btn-brass" style="width: 100%;" onclick="alert('Split-Ticket Booking Initialized! PNRs generated for both connecting legs.')">Book Both Connecting Legs (Guaranteed Seat)</button>
        `;
        container.appendChild(card);
    });
}

// ----------------- PASSENGER BOOKING & DEMOGRAPHIC ALLOCATION -----------------
function selectTrainForBooking(trainNum) {
    AppState.selectedTrain = RAILWAY_DATA.trains.find(t => t.number === trainNum);
    if (!AppState.selectedTrain) return;

    // Switch tab to booking
    document.querySelectorAll(".tab-btn").forEach(t => t.classList.remove("active"));
    document.querySelectorAll(".tab-panel").forEach(p => p.classList.remove("active"));
    document.querySelector('[data-tab="booking-tab"]').classList.add("active");
    document.getElementById("booking-tab").classList.add("active");

    const fare = SortingEngine.calculateFare(AppState.selectedTrain, AppState.fromStation, AppState.toStation, AppState.selectedClass, AppState.selectedQuota);

    document.getElementById("selectedTrainBanner").innerHTML = `
        <b>Selected Train:</b> [${AppState.selectedTrain.number}] ${AppState.selectedTrain.name} &nbsp;|&nbsp;
        <b>Route:</b> ${AppState.fromStation} ➔ ${AppState.toStation} &nbsp;|&nbsp;
        <b>Class:</b> ${AppState.selectedClass} &nbsp;|&nbsp;
        <b>Fare/Seat:</b> ₹${fare}
    `;
}

function renderPassengerList() {
    const list = document.getElementById("passengerList");
    list.innerHTML = "";

    AppState.passengers.forEach((p, idx) => {
        const item = document.createElement("div");
        item.style.display = "flex";
        item.style.justifyContent = "space-between";
        item.style.alignItems = "center";
        item.style.padding = "0.6rem 0.8rem";
        item.style.background = "#fff";
        item.style.border = "1px solid var(--border-color)";
        item.style.borderRadius = "6px";
        item.style.marginBottom = "0.5rem";

        item.innerHTML = `
            <div>
                <b>${p.name}</b> (${p.age}y, ${p.gender})
                <div style="font-size: 0.8rem; color: var(--text-muted);">Pref: ${p.prefBerth} | ${p.isSenior ? '⭐ Senior/Special Priority' : 'General'}</div>
            </div>
            <button style="background: none; border: none; color: var(--danger-red); cursor: pointer; font-size: 1.1rem;" onclick="removePassenger(${idx})">✕</button>
        `;
        list.appendChild(item);
    });
}

function addPassenger() {
    const name = prompt("Enter passenger name:", "Passenger " + (AppState.passengers.length + 1));
    if (!name) return;
    const age = parseInt(prompt("Enter passenger age:", "35")) || 30;
    const gender = prompt("Enter Gender (M/F):", "M").toUpperCase();
    const isSenior = (gender === "F" && age >= 58) || (age >= 60);

    AppState.passengers.push({
        name,
        age,
        gender,
        prefBerth: isSenior ? "LOWER" : "MIDDLE",
        isSenior
    });
    renderPassengerList();
}

function removePassenger(idx) {
    AppState.passengers.splice(idx, 1);
    renderPassengerList();
}

function loadSampleFamily() {
    AppState.passengers = [
        { name: "Harish Verma (Senior Citizen)", age: 68, gender: "M", prefBerth: "LOWER", isSenior: true },
        { name: "Meenakshi Verma (Mother)", age: 38, gender: "F", prefBerth: "LOWER", isSenior: false },
        { name: "Aarav Verma (Child)", age: 8, gender: "M", prefBerth: "UPPER", isSenior: false }
    ];
    renderPassengerList();
}

function processReservation() {
    if (!AppState.selectedTrain) {
        AppState.selectedTrain = AppState.currentSearchResults[0] || RAILWAY_DATA.trains[1];
    }
    if (AppState.passengers.length === 0) {
        alert("Please add at least one passenger.");
        return;
    }

    const pnr = `248-${Math.floor(1000000 + Math.random() * 9000000)}`;
    const farePerSeat = SortingEngine.calculateFare(AppState.selectedTrain, AppState.fromStation, AppState.toStation, AppState.selectedClass, AppState.selectedQuota);
    const totalFare = farePerSeat * AppState.passengers.length;

    // Execute Demographic Sorting (Seniors get Lower Berth #1, #4)
    const sorted = [...AppState.passengers].sort((p1, p2) => {
        if (p1.isSenior !== p2.isSenior) return p1.isSenior ? -1 : 1;
        return p2.age - p1.age;
    });

    const allocated = sorted.map((p, idx) => {
        let berth = p.isSenior ? "LOWER" : (idx === 1 ? "LOWER" : "UPPER");
        let seatNum = idx === 0 ? 1 : (idx === 1 ? 4 : 3);
        return {
            ...p,
            status: "CONFIRMED",
            coach: "B1",
            seatNum,
            berth
        };
    });

    const ticketRecord = {
        pnr,
        train: AppState.selectedTrain,
        from: AppState.fromStation,
        to: AppState.toStation,
        class: AppState.selectedClass,
        quota: AppState.selectedQuota,
        totalFare,
        passengers: allocated,
        date: "2026-09-05",
        confirmationProb: 98.5
    };

    AppState.bookedTickets.set(pnr, ticketRecord);

    // Render E-Ticket in Output box
    const outBox = document.getElementById("bookingResultBox");
    outBox.innerHTML = `
        <div style="background: #FAF8F5; border: 2px solid var(--brass-gold); border-radius: 8px; padding: 1.25rem;">
            <div style="display: flex; justify-content: space-between; border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 0.75rem;">
                <h4 style="color: var(--primary-blue);">🎫 E-TICKET CONFIRMATION</h4>
                <div style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: var(--vintage-brown);">PNR: ${pnr}</div>
            </div>
            <div><b>Train:</b> [${AppState.selectedTrain.number}] ${AppState.selectedTrain.name}</div>
            <div><b>Journey:</b> ${AppState.fromStation} ➔ ${AppState.toStation} | Date: ${ticketRecord.date}</div>
            <div><b>Class & Quota:</b> ${AppState.selectedClass} | ${AppState.selectedQuota}</div>
            <div><b>Total Fare:</b> ₹${totalFare} (Paid)</div>
            <div><b>Confirmation Probability:</b> <span style="color: var(--success-green); font-weight: 800;">${ticketRecord.confirmationProb}% (HIGH)</span></div>
            
            <h5 style="margin-top: 0.75rem; color: var(--vintage-brown);">Allocated Berths (Demographic Optimization):</h5>
            <ul style="padding-left: 1.25rem; font-size: 0.88rem; margin-top: 0.25rem;">
                ${allocated.map(p => `<li><b>${p.name}</b> ➔ Status: <span style="color:var(--success-green);font-weight:700;">CNF</span> | Coach: <b>${p.coach}</b> | Seat: <b>#${p.seatNum} (${p.berth} Berth)</b></li>`).join("")}
            </ul>
        </div>
    `;

    document.getElementById("pnrInput").value = pnr;
}

// ----------------- PNR QUERY & CANCELLATION -----------------
function seedInitialDemoBooking() {
    const demoPNR = "248-8910472";
    AppState.bookedTickets.set(demoPNR, {
        pnr: demoPNR,
        train: RAILWAY_DATA.trains[1],
        from: "NDLS",
        to: "HWH",
        class: "3A",
        quota: "GENERAL",
        totalFare: 4756,
        date: "2026-09-02",
        confirmationProb: 99.0,
        passengers: [
            { name: "Harish Verma (Senior Citizen)", age: 68, gender: "M", status: "CONFIRMED", coach: "B1", seatNum: 1, berth: "LOWER" },
            { name: "Meenakshi Verma (Mother)", age: 40, gender: "F", status: "CONFIRMED", coach: "B1", seatNum: 4, berth: "LOWER" }
        ]
    });
}

function queryPnrStatus() {
    const pnr = document.getElementById("pnrInput").value.trim();
    const resultBox = document.getElementById("pnrResultBox");
    const ticket = AppState.bookedTickets.get(pnr);

    if (!ticket) {
        resultBox.innerHTML = `
            <div style="padding: 2rem; text-align: center; color: var(--danger-red);">
                <h4>❌ PNR NOT FOUND</h4>
                <p>No booking record located for PNR "${pnr}". Please verify the number or book a new ticket in Tab 3.</p>
            </div>
        `;
        return;
    }

    resultBox.innerHTML = `
        <div style="background: #fff; border: 1.5px solid var(--border-color); border-radius: 8px; padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--border-subtle); padding-bottom: 0.75rem;">
                <div>
                    <h3 style="color: var(--midnight-blue);">PNR: ${ticket.pnr}</h3>
                    <div style="color: var(--text-muted); font-size: 0.85rem;">Train: [${ticket.train.number}] ${ticket.train.name}</div>
                </div>
                <div style="background: ${ticket.isCancelled ? 'var(--danger-red)' : 'var(--success-green)'}; color: #fff; padding: 0.35rem 0.85rem; border-radius: 4px; font-weight: 700;">
                    ${ticket.isCancelled ? 'CANCELLED' : 'CONFIRMED (CNF)'}
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin: 1rem 0;">
                <div><b>Journey:</b> ${ticket.from} ➔ ${ticket.to}</div>
                <div><b>Date:</b> ${ticket.date}</div>
                <div><b>Class / Quota:</b> ${ticket.class} / ${ticket.quota}</div>
                <div><b>Total Paid:</b> ₹${ticket.totalFare}</div>
                <div><b>Confirmation Odds:</b> ${ticket.confirmationProb}%</div>
            </div>

            <h4 style="color: var(--vintage-brown); margin-top: 1rem;">Passenger Manifest:</h4>
            <div style="margin-top: 0.5rem;">
                ${ticket.passengers.map(p => `
                    <div style="display:flex; justify-content:space-between; padding:0.5rem; background:var(--bg-ivory); border-radius:4px; margin-bottom:0.35rem;">
                        <span><b>${p.name}</b> (${p.gender}, ${p.age}y)</span>
                        <span>Coach: <b>${p.coach || '-'}</b> | Seat: <b>#${p.seatNum || '-'} (${p.berth || '-'})</b> | Status: <b>${ticket.isCancelled ? 'CAN' : p.status}</b></span>
                    </div>
                `).join("")}
            </div>
        </div>
    `;
}

function cancelPnrBooking() {
    const pnr = document.getElementById("pnrInput").value.trim();
    const ticket = AppState.bookedTickets.get(pnr);
    if (!ticket) {
        alert("Please enter a valid booked PNR to cancel.");
        return;
    }
    if (confirm(`Are you sure you want to cancel PNR ${pnr}? Allocated berths will be returned to the coach inventory.`)) {
        ticket.isCancelled = true;
        queryPnrStatus();
        alert(`Booking for PNR ${pnr} has been cancelled.`);
    }
}
